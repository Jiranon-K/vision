# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vision

# JWT
JWT_SECRET=replace-me-with-32+-char-random-string
# Refresh tokens are signed with their own key so an access token can never be
# presented as a refresh token. Required — there is no fallback to JWT_SECRET.
JWT_REFRESH_SECRET=replace-me-with-a-different-32+-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
# Shared rate limit store. Required in production: the in-memory fallback is
# per process, so every limit is multiplied by the instance count and reset by
# every deploy. Leave unset for local development.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# HTTP
PORT=3001
NODE_ENV=development

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Resend email provider
# Get an API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Vision

# Admin
# Comma-separated emails treated as admins (promoted on register, self-healed on login).
ADMIN_EMAILS=

# Excerpt Suggestions (optional — capability is unavailable if unset)
# Google AI Studio API key; enables the Google provider (Gemini) when set.
GOOGLE_GENERATIVE_AI_API_KEY=
# Overrides the default Gemini model without a code change.
AI_EXCERPT_MODEL=gemini-3.1-flash-lite
# Set to "stub" to force a deterministic fake provider (Playwright/local use only — never in production).
AI_PROVIDER=
# How long to wait on a provider before falling back to the derived Excerpt (ms, default 8000).
AI_SUGGESTION_TIMEOUT_MS=
