{
  "projectId": "bb94964a-613b-4b30-b337-2e72cd318810",
  "shape": "package",
  "pkg": "vision",
  "globalName": "VisionDS",
  "buildCmd": "bun run build && node .design-sync/prepare-css.mjs && bunx tsc -p .design-sync/tsconfig.dts.json",
  "entry": ".design-sync/ds-entry.ts",
  "srcDir": "components",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".design-sync/.cache/vision-compiled.css",
  "extraFonts": [".design-sync/.cache/fonts/fonts.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "ConfirmDialog": { "cardMode": "single", "viewport": "640x420" }
  },
  "componentSrcMap": {
    "Alert": "components/ui/alert.tsx",
    "Badge": "components/ui/badge.tsx",
    "Button": "components/ui/button.tsx",
    "Card": "components/ui/card.tsx",
    "CardHeader": "components/ui/card.tsx",
    "CardTitle": "components/ui/card.tsx",
    "CardDescription": "components/ui/card.tsx",
    "CardContent": "components/ui/card.tsx",
    "CardFooter": "components/ui/card.tsx",
    "Checkbox": "components/ui/checkbox.tsx",
    "ConfirmDialog": "components/ui/ConfirmDialog.tsx",
    "FieldMessage": "components/ui/field-message.tsx",
    "Input": "components/ui/input.tsx",
    "Label": "components/ui/label.tsx",
    "Skeleton": "components/ui/Skeleton.tsx",
    "Spinner": "components/ui/spinner.tsx",
    "DashboardIcon": "components/ui/Icons.tsx",
    "EyeIcon": "components/ui/Icons.tsx",
    "EyeOffIcon": "components/ui/Icons.tsx",
    "PostsIcon": "components/ui/Icons.tsx",
    "AnalyticsIcon": "components/ui/Icons.tsx",
    "SettingsIcon": "components/ui/Icons.tsx",
    "LogoIcon": "components/ui/Icons.tsx",
    "LogoutIcon": "components/ui/Icons.tsx",
    "HomeIcon": "components/ui/Icons.tsx",
    "EditIcon": "components/ui/Icons.tsx",
    "DeleteIcon": "components/ui/Icons.tsx",
    "PlusIcon": "components/ui/Icons.tsx",
    "UploadIcon": "components/ui/Icons.tsx",
    "ChartIcon": "components/ui/Icons.tsx"
  }
}
